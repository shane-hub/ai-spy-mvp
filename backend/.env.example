PORT=3000

# Primary pixel models: AI generation/editing + deepfake
SIGHTENGINE_API_USER=your_real_user_id
SIGHTENGINE_API_SECRET=your_real_secret_key

# Optional Hive gray-zone review. Leave empty to disable.
HIVE_API_KEY=
HIVE_API_URL=https://api.thehive.ai/api/v2/task/sync
HIVE_REVIEW_LOW=0.35
HIVE_REVIEW_HIGH=0.65
HIVE_ALWAYS_REVIEW=false

# Combined risk thresholds
LOW_RISK_THRESHOLD=0.35
HIGH_RISK_THRESHOLD=0.80

# C2PA is checked before paid providers. Enable only if a valid AI declaration
# should be considered decisive without also running the pixel models.
C2PA_SHORT_CIRCUIT=false

# Trusted client/proxy shared secret. Rotate before public launch.
APP_CLIENT_SECRET=replace_with_a_long_random_secret
